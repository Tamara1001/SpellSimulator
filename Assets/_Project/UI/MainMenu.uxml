<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="SpellUI.uss" />
    <Style src="MainMenu.uss" />
    <!-- Menu principal (UI.MainMenu): columna de cuero a la izquierda sobre la camara que orbita la torre. -->
    <ui:VisualElement name="menu" class="mm mm--enter">
        <ui:VisualElement class="mm-shade" picking-mode="Ignore" />
        <ui:VisualElement class="mm-fade" picking-mode="Ignore" />
        <ui:VisualElement name="motes" class="mm-motes" picking-mode="Ignore" />

        <ui:VisualElement name="column" class="mm-column">
            <ui:VisualElement class="mm-column-bg" picking-mode="Ignore" />
            <ui:VisualElement class="mm-column-edge" picking-mode="Ignore" />

            <ui:VisualElement class="mm-head" picking-mode="Ignore">
                <ui:VisualElement class="mm-crest">
                    <ui:VisualElement class="mm-crest-glow" />
                    <ui:VisualElement class="mm-crest-seal" />
                </ui:VisualElement>
                <ui:Label text="SIMULADOR DE HECHICERÍA" class="mm-kicker" />
                <ui:Label text="SpellSimulator" class="mm-title" />
                <ui:VisualElement class="mm-divider" />
                <ui:Label text="Dibujá el sello, nombrá el mundo." class="mm-subtitle" />
            </ui:VisualElement>

            <ui:VisualElement name="buttons" class="mm-buttons">
                <ui:Button name="sandbox" class="mm-button mm-button--primary">
                    <ui:VisualElement class="mm-gem" picking-mode="Ignore" />
                    <ui:VisualElement class="mm-button-text" picking-mode="Ignore">
                        <ui:Label text="Modo Sandbox" class="mm-label" picking-mode="Ignore" />
                        <ui:Label text="El simulador libre: la torre y la pradera" class="mm-sub" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="multiplayer" class="mm-button">
                    <ui:VisualElement class="mm-gem" picking-mode="Ignore" />
                    <ui:VisualElement class="mm-button-text" picking-mode="Ignore">
                        <ui:Label text="Multijugador" class="mm-label" picking-mode="Ignore" />
                        <ui:Label name="multiplayer-sub" text="Crear una sala o unirse con un código" class="mm-sub" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="duel" class="mm-button">
                    <ui:VisualElement class="mm-gem" picking-mode="Ignore" />
                    <ui:VisualElement class="mm-button-text" picking-mode="Ignore">
                        <ui:Label text="Modo Duelo" class="mm-label" picking-mode="Ignore" />
                        <ui:Label text="1 contra 1 en red, al mejor de 3" class="mm-sub" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="info" class="mm-button">
                    <ui:VisualElement class="mm-gem" picking-mode="Ignore" />
                    <ui:VisualElement class="mm-button-text" picking-mode="Ignore">
                        <ui:Label text="Información" class="mm-label" picking-mode="Ignore" />
                        <ui:Label text="Abrir el grimorio" class="mm-sub" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="credits" class="mm-button">
                    <ui:VisualElement class="mm-gem" picking-mode="Ignore" />
                    <ui:VisualElement class="mm-button-text" picking-mode="Ignore">
                        <ui:Label text="Créditos" class="mm-label" picking-mode="Ignore" />
                        <ui:Label text="Quién hizo este simulador" class="mm-sub" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="quit" class="mm-button mm-button--quiet">
                    <ui:VisualElement class="mm-gem" picking-mode="Ignore" />
                    <ui:VisualElement class="mm-button-text" picking-mode="Ignore">
                        <ui:Label text="Salir" class="mm-label" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
            </ui:VisualElement>

            <ui:VisualElement class="mm-foot" picking-mode="Ignore">
                <ui:Label text="Configuración de teclas: próximamente" class="mm-hint" />
                <ui:VisualElement class="mm-help">
                    <ui:Label text="↑ ↓" class="keycap keycap--small" />
                    <ui:Label text="elegir" class="mm-help-text" />
                    <ui:Label text="Enter" class="keycap keycap--small" />
                    <ui:Label text="aceptar" class="mm-help-text" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label name="version" text="v0.6 · prototipo" class="mm-version" picking-mode="Ignore" />

        <!-- Creditos: hoja de pergamino sobre el menu. -->
        <ui:VisualElement name="credits-panel" class="mm-credits mm-credits--hidden">
            <ui:VisualElement name="credits-backdrop" class="mm-credits-backdrop" />
            <ui:VisualElement class="mm-sheet">
                <ui:VisualElement class="mm-sheet-cover" picking-mode="Ignore" />
                <ui:VisualElement class="mm-sheet-page">
                    <ui:Label text="CRÉDITOS" class="kicker" />
                    <ui:Label text="SpellSimulator" class="mm-sheet-title" />
                    <ui:VisualElement class="divider divider--wide" />
                    <ui:VisualElement class="mm-credit-grid">
                    <ui:VisualElement class="mm-credit">
                        <ui:Label text="PROGRAMACIÓN" class="mm-credit-role" />
                        <ui:Label text="Tamara D'Angelo" class="mm-credit-name" />
                    </ui:VisualElement>
                    <ui:VisualElement class="mm-credit">
                        <ui:Label text="ARTE" class="mm-credit-role" />
                        <ui:Label text="Tamara D'Angelo" class="mm-credit-name" />
                    </ui:VisualElement>
                    <ui:VisualElement class="mm-credit">
                        <ui:Label text="DISEÑO DE JUEGO" class="mm-credit-role" />
                        <ui:Label text="Tamara D'Angelo" class="mm-credit-name" />
                    </ui:VisualElement>
                    <ui:VisualElement class="mm-credit">
                        <ui:Label text="DISEÑO DE INTERFAZ" class="mm-credit-role" />
                        <ui:Label text="Tamara D'Angelo" class="mm-credit-name" />
                    </ui:VisualElement>
                    <ui:VisualElement class="mm-credit">
                        <ui:Label text="MÚSICA Y SONIDO" class="mm-credit-role" />
                        <ui:Label text="Tamara D'Angelo" class="mm-credit-name" />
                    </ui:VisualElement>
                    <ui:VisualElement class="mm-credit">
                        <ui:Label text="VFX" class="mm-credit-role" />
                        <ui:Label text="Tamara D'Angelo" class="mm-credit-name" />
                    </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="divider divider--wide mm-sheet-rule" />
                    <ui:Label text="Hecho con Unity 6" class="mm-sheet-made" />
                    <ui:Label text="v0.1.0 · prototipo" class="mm-sheet-ver" />
                    <ui:Button name="credits-back" class="mm-back" text="Volver" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="mm-credits-help" picking-mode="Ignore">
                <ui:Label text="Esc" class="keycap keycap--dark" />
                <ui:Label text="volver" class="reader-help-text" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Multijugador: hoja de pergamino para crear una sala o unirse con un codigo. -->
        <ui:VisualElement name="net-panel" class="mm-credits mm-credits--hidden">
            <ui:VisualElement name="net-backdrop" class="mm-credits-backdrop" />
            <ui:VisualElement class="mm-sheet mm-sheet--net">
                <ui:VisualElement class="mm-sheet-cover" picking-mode="Ignore" />
                <ui:VisualElement class="mm-sheet-page">
                    <ui:Label text="MULTIJUGADOR" class="kicker" />
                    <ui:Label text="Jugar con amigos" class="mm-sheet-title" />
                    <ui:VisualElement class="divider divider--wide" />
                    <ui:Label text="Tu nombre" class="mm-net-label" />
                    <ui:TextField name="net-name" max-length="16" class="mm-net-field" />
                    <ui:Toggle name="net-ink" text="Tinta limitada (sala cooperativa)" class="mm-net-label" />
                    <ui:Button name="net-host" class="mm-back mm-net-action" text="Crear sala" />
                    <ui:Label text="o unite a una sala con su código" class="mm-net-or" />
                    <ui:TextField name="net-code" max-length="8" class="mm-net-field mm-net-field--code" />
                    <ui:Button name="net-join" class="mm-back mm-net-action" text="Unirse" />
                    <ui:Label name="net-status" text="" class="mm-net-status" />
                    <ui:Button name="net-reconnect" class="mm-back mm-net-action" text="Reconectar" />
                    <ui:Button name="net-leave" class="mm-back mm-net-action" text="Salir de la sala" />
                    <ui:Button name="net-back" class="mm-back" text="Volver" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
