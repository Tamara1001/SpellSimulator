/* SpellSimulator · tema de la interfaz (UI Toolkit). Pergamino, tinta violeta y filigrana dorada.
   Sprites generados por Editor/UISpriteGenerator.cs (menu SpellSimulator/UI/Setup Current Scene). */

:root {
    --ink: rgb(52, 34, 22);
    --ink-soft: rgb(110, 82, 56);
    --cream: rgb(246, 234, 206);
    --cream-dim: rgb(214, 198, 168);
    --gold: rgb(222, 172, 78);
    --gold-light: rgb(246, 220, 150);
    --bronze: rgb(150, 112, 60);
    --violet: rgb(92, 58, 124);
    --violet-deep: rgba(26, 16, 36, 0.86);
    --amber: rgb(232, 150, 52);
    --danger: rgb(214, 74, 52);
    -unity-font-style: normal;
}

.screen {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

.hud {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.hud--hidden {
    opacity: 0;
}

/* ------------------------------------------------------------ keycaps */

.keycap {
    min-width: 24px;
    height: 24px;
    padding: 0 7px 2px 7px;
    margin: 0 5px 0 0;
    background-image: url("Sprites/keycap.png");
    -unity-slice-left: 8; -unity-slice-right: 8; -unity-slice-top: 8; -unity-slice-bottom: 8;
    color: var(--ink);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    flex-shrink: 0;
}

.keycap--small {
    min-width: 20px;
    height: 20px;
    font-size: 11px;
    padding: 0 5px 3px 5px;
    margin: 0;
}

.keycap--hover {
    min-width: 30px;
    height: 30px;
    font-size: 15px;
    padding: 0 8px 3px 8px;
    margin: 0;
}

.keycap--dark {
    -unity-background-image-tint-color: rgb(236, 220, 186);
}

/* ------------------------------------------------------------ [E] junto a la mira */

.hover-key {
    position: absolute;
    left: 50%;
    top: 50%;
    margin-left: 22px;
    margin-top: 10px;
    opacity: 0;
    scale: 0.8 0.8;
    transition-property: opacity, scale;
    transition-duration: 0.12s, 0.12s;
}

.hover-key--on {
    opacity: 1;
    scale: 1 1;
}

/* ------------------------------------------------------------ zona inferior */

.bottom {
    position: absolute;
    left: 0; right: 0; bottom: 18px;
    align-items: center;
    justify-content: flex-end;
}

/* Panel de contexto: 1 o 2 lineas, sobre la barra. */
.context {
    max-width: 1200px;
    margin-bottom: 10px;
    padding: 7px 18px 7px 18px;
    background-image: url("Sprites/panel_dark.png");
    -unity-slice-left: 16; -unity-slice-right: 16; -unity-slice-top: 16; -unity-slice-bottom: 16;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.18s, 0.18s;
}

.context--empty {
    opacity: 0;
    translate: 0 8px;
}

.ctx-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 30px;
}

.ctx-row--sec {
    border-top-width: 1px;
    border-top-color: rgba(222, 172, 78, 0.25);
    margin-top: 3px;
    padding-top: 3px;
}

.ctx-name {
    color: var(--gold-light);
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-right: 14px;
    -unity-text-outline-width: 0.15px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.6);
    white-space: nowrap;
}

.ctx-name--sec {
    color: var(--cream-dim);
}

.hints {
    flex-direction: row;
    align-items: center;
}

.hint {
    flex-direction: row;
    align-items: center;
    margin-left: 10px;
}

.hint-text {
    color: var(--cream);
    font-size: 14px;
    white-space: nowrap;
}

.page-label {
    color: var(--gold);
    font-size: 14px;
    -unity-font-style: italic;
    margin-right: 6px;
    white-space: nowrap;
}

/* Selector de grosores: trazos de tamaño creciente, el actual en oro. */
.widths {
    flex-direction: row;
    align-items: center;
    height: 26px;
    padding: 0 8px 0 8px;
    margin-right: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-left-color: rgba(222, 172, 78, 0.3);
    border-right-color: rgba(222, 172, 78, 0.3);
}

.width-dot {
    width: 18px;
    height: 22px;
    margin: 0 1px 0 1px;
    align-items: center;
    justify-content: center;
}

.width-mark {
    width: 12px;
    border-radius: 3px;
    background-color: rgba(246, 234, 206, 0.35);
    transition-property: background-color, scale;
    transition-duration: 0.12s, 0.12s;
}

.width-dot--on .width-mark {
    background-color: var(--gold-light);
    scale: 1.15 1.15;
}

.width-label {
    color: var(--gold-light);
    font-size: 13px;
    -unity-font-style: italic;
    margin-left: 6px;
    min-width: 52px;
}

/* Barra de tinta con gotita. */
.ink {
    flex-direction: row;
    align-items: center;
    margin-right: 6px;
}

.ink-drop {
    width: 16px;
    height: 20px;
    background-image: url("Sprites/drop.png");
    margin-right: 5px;
    transition-property: -unity-background-image-tint-color;
    transition-duration: 0.3s;
}

.ink-track {
    width: 96px;
    height: 7px;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.45);
    border-width: 1px;
    border-color: rgba(222, 172, 78, 0.55);
    overflow: hidden;
}

.ink-fill {
    height: 100%;
    width: 100%;
    border-radius: 3px;
    background-color: rgb(150, 104, 210);
    transition-property: background-color;
    transition-duration: 0.3s;
}

.ink-pct {
    color: var(--cream-dim);
    font-size: 13px;
    margin-left: 6px;
    min-width: 38px;
}

.ink--low .ink-fill {
    background-color: var(--danger);
}

.ink--low .ink-pct {
    color: rgb(255, 140, 110);
}

.ink--blink .ink-drop {
    -unity-background-image-tint-color: rgb(255, 110, 90);
}

.ink--blink .ink-fill {
    background-color: rgb(255, 120, 96);
}

/* ------------------------------------------------------------ barra de objetos */

.bar {
    flex-direction: row;
    align-items: flex-end;
}

.hand {
    align-items: center;
}

.hand-gap {
    width: 26px;
}

.hand-label {
    color: var(--gold-light);
    font-size: 11px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    margin-bottom: 4px;
    opacity: 0.75;
    -unity-text-outline-width: 0.2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.7);
}

.slot-tray {
    flex-direction: row;
    padding: 10px 10px 7px 10px;
    background-image: url("Sprites/tray.png");
    -unity-slice-left: 18; -unity-slice-right: 18; -unity-slice-top: 18; -unity-slice-bottom: 18;
}

.slot {
    width: 76px;
    align-items: center;
    margin: 0 3px 0 3px;
}

.slot-frame {
    width: 64px;
    height: 64px;
    background-image: url("Sprites/slot.png");
    -unity-slice-left: 14; -unity-slice-right: 14; -unity-slice-top: 14; -unity-slice-bottom: 14;
    transition-property: scale, translate;
    transition-duration: 0.15s, 0.15s;
}

.slot-glow {
    position: absolute;
    left: -22px; top: -22px; right: -22px; bottom: -22px;
    background-image: url("Sprites/glow.png");
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.slot-icon {
    position: absolute;
    left: 5px; top: 5px; right: 5px; bottom: 5px;
    -unity-background-scale-mode: scale-to-fit;
}

.slot-icon--color {
    left: 18px; top: 18px; right: 18px; bottom: 18px;
    background-image: url("Sprites/gem.png");
}

.slot-icon--empty {
    left: 20px; top: 20px; right: 20px; bottom: 20px;
    background-image: url("Sprites/empty.png");
    opacity: 0.35;
}

.slot-key {
    position: absolute;
    left: -6px;
    top: -7px;
}

.slot-name {
    color: var(--cream);
    font-size: 12px;
    max-width: 76px;
    margin-top: 2px;
    -unity-text-align: upper-center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-outline-width: 0.2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
    height: 17px;
}

.slot--active .slot-frame {
    background-image: url("Sprites/slot_active.png");
    translate: 0 -3px;
    scale: 1.06 1.06;
}

.slot--active .slot-glow {
    opacity: 0.85;
}

.slot--active .slot-name {
    color: var(--gold-light);
    -unity-font-style: bold;
}

.slot--empty .slot-name {
    opacity: 0.45;
}

/* ------------------------------------------------------------ avisos */

.notices {
    position: absolute;
    top: 22px;
    right: 22px;
    width: 340px;
    align-items: flex-end;
}

.notice {
    flex-direction: row;
    align-items: center;
    max-width: 340px;
    min-height: 40px;
    margin-bottom: 8px;
    padding: 8px 14px 8px 10px;
    background-image: url("Sprites/parchment.png");
    -unity-slice-left: 18; -unity-slice-right: 18; -unity-slice-top: 18; -unity-slice-bottom: 18;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.28s, 0.28s;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

.notice--in {
    opacity: 0;
    translate: 60px 0;
}

.notice--out {
    opacity: 0;
    translate: 60px 0;
}

.notice--fading {
    opacity: 0;
    transition-duration: 0.6s, 0.6s;
}

.notice--warn {
    background-image: url("Sprites/parchment_warn.png");
}

.notice-icon {
    width: 22px;
    height: 22px;
    margin-right: 9px;
    flex-shrink: 0;
    background-image: url("Sprites/quill.png");
}

.notice--warn .notice-icon {
    background-image: url("Sprites/warn.png");
}

.notice--disc .notice-icon {
    background-image: url("Sprites/star.png");
}

.notice-text {
    color: var(--ink);
    font-size: 14px;
    white-space: normal;
    flex-shrink: 1;
}

.notice--warn .notice-text {
    color: rgb(110, 40, 20);
    -unity-font-style: bold;
}

/* ------------------------------------------------------------ lector de libros */

.reader {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.reader--hidden {
    display: none;
}

.reader--fading {
    opacity: 0;
}

.reader-backdrop {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(12, 6, 18, 0.72);
}

.book {
    width: 1300px;
    height: 780px;
    scale: 1 1;
    translate: 0 0;
    transition-property: scale, translate;
    transition-duration: 0.3s, 0.3s;
    transition-timing-function: ease-out-back, ease-out-cubic;
}

.reader--fading .book {
    scale: 0.94 0.94;
    translate: 0 24px;
}

.book-cover {
    position: absolute;
    left: -26px; top: -24px; right: -26px; bottom: -28px;
    background-image: url("Sprites/cover.png");
    -unity-slice-left: 28; -unity-slice-right: 28; -unity-slice-top: 28; -unity-slice-bottom: 28;
}

.ribbon {
    position: absolute;
    left: 1238px;
    top: -12px;
    width: 22px;
    height: 840px;
    background-image: url("Sprites/ribbon.png");
}

.book-pages {
    flex-direction: row;
    flex-grow: 1;
}

.page {
    flex-grow: 1;
    flex-basis: 0;
    background-image: url("Sprites/page.png");
    -unity-slice-left: 24; -unity-slice-right: 24; -unity-slice-top: 24; -unity-slice-bottom: 24;
    padding: 56px 66px 54px 66px;
}

.page-shade {
    position: absolute;
    top: 0; bottom: 0;
    width: 90px;
    background-image: url("Sprites/gutter.png");
}

.page-shade--left {
    right: 0;
}

.page-shade--right {
    left: 0;
    scale: -1 1;
}

.page-content {
    flex-grow: 1;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.16s, 0.16s;
}

.page-content--left {
    align-items: center;
    justify-content: center;
}

.page-content--turning {
    opacity: 0;
    translate: 0 6px;
}

.kicker {
    color: var(--violet);
    font-size: 15px;
    letter-spacing: 4px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.page-content--right .kicker {
    -unity-text-align: middle-left;
}

.cover-title {
    color: var(--ink);
    font-size: 46px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    letter-spacing: 1px;
    margin-top: 6px;
}

.cover-subtitle {
    color: var(--ink-soft);
    font-size: 19px;
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 6px;
}

.sketch-host {
    width: 400px;
    height: 400px;
    margin-top: 8px;
}

.sketch-host--small {
    width: 230px;
    height: 230px;
    margin-top: 28px;
}

.caption {
    color: var(--ink);
    font-size: 26px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-top: 10px;
    -unity-text-align: middle-center;
}

.heading {
    color: var(--ink);
    font-size: 38px;
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 2px;
}

.divider {
    height: 16px;
    width: 300px;
    margin: 6px 0 16px 0;
    background-image: url("Sprites/divider.png");
    -unity-background-scale-mode: scale-to-fit;
}

.page-content--right .divider {
    align-self: flex-start;
    width: 220px;
}

.divider--wide {
    width: 380px;
    align-self: center;
    margin: 14px 0 6px 0;
}

.body {
    color: var(--ink);
    font-size: 20px;
    white-space: normal;
}

.page-spacer {
    flex-grow: 1;
}

.note {
    flex-direction: row;
    align-items: center;
    margin-top: 14px;
    padding: 8px 12px 8px 8px;
    border-radius: 6px;
    background-color: rgba(92, 58, 124, 0.1);
    border-width: 1px;
    border-color: rgba(92, 58, 124, 0.35);
}

.note-seal {
    width: 34px;
    height: 34px;
    margin-right: 10px;
    background-image: url("Sprites/seal.png");
}

.note-text {
    color: var(--violet);
    font-size: 17px;
    -unity-font-style: italic;
    white-space: normal;
    flex-shrink: 1;
}

.learn-button {
    flex-direction: row;
    align-self: center;
    align-items: center;
    margin-top: 20px;
    height: 64px;
    padding: 0 30px 0 12px;
    background-image: url("Sprites/button.png");
    -unity-slice-left: 16; -unity-slice-right: 16; -unity-slice-top: 16; -unity-slice-bottom: 16;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    scale: 1 1;
    transition-property: scale, -unity-background-image-tint-color;
    transition-duration: 0.12s, 0.12s;
}

.learn-button:hover {
    scale: 1.04 1.04;
    -unity-background-image-tint-color: rgb(255, 236, 200);
}

.learn-button:active {
    scale: 0.97 0.97;
}

.learn-seal {
    width: 52px;
    height: 52px;
    margin-right: 12px;
    background-image: url("Sprites/seal.png");
}

.learn-text {
    color: var(--gold-light);
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-outline-width: 0.2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.7);
}

.folio {
    position: absolute;
    bottom: 24px;
    left: 0; right: 0;
    color: var(--ink-soft);
    font-size: 14px;
    -unity-font-style: italic;
    -unity-text-align: middle-center;
}

.nav {
    position: absolute;
    top: 50%;
    width: 52px;
    height: 76px;
    margin-top: -38px;
    background-image: url("Sprites/tab.png");
    -unity-slice-left: 12; -unity-slice-right: 12; -unity-slice-top: 12; -unity-slice-bottom: 12;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--gold-light);
    font-size: 40px;
    -unity-text-align: middle-center;
    padding: 0 0 6px 0;
    transition-property: translate, opacity;
    transition-duration: 0.12s, 0.12s;
}

.nav--prev {
    left: -78px;
}

.nav--next {
    right: -78px;
}

.nav--prev:hover {
    translate: -4px 0;
}

.nav--next:hover {
    translate: 4px 0;
}

.nav--disabled {
    opacity: 0.25;
}

.close-button {
    position: absolute;
    top: -58px;
    right: -18px;
    height: 36px;
    padding: 0 16px 2px 16px;
    background-image: url("Sprites/button.png");
    -unity-slice-left: 16; -unity-slice-right: 16; -unity-slice-top: 16; -unity-slice-bottom: 16;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--gold-light);
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.close-button:hover {
    -unity-background-image-tint-color: rgb(255, 236, 200);
}

.reader-footer {
    position: absolute;
    bottom: 26px;
    left: 0; right: 0;
    align-items: center;
}

.counter {
    color: var(--gold-light);
    font-size: 16px;
    letter-spacing: 3px;
    margin-bottom: 8px;
}

.reader-help {
    flex-direction: row;
    align-items: center;
}

.reader-help-text {
    color: var(--cream-dim);
    font-size: 14px;
    margin-right: 18px;
}
