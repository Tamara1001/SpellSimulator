    name: Portal del estudio
    use: "Primer piso de la torre. El portal est\xE1 ah\xED: cruzalo para viajar."
    color: '#8E4FD6'
    origin: Tower
    x: 0
    z: 16
  - id: watchtower
    name: Portal de la atalaya
    use: "Arriba de la torre de vig\xEDa. El portal est\xE1 ah\xED: cruzalo para
      viajar."
    color: '#1F9E89'
    origin: Watchtower
    x: 37.28168
    z: 44.430576
  - id: field-circle
    name: "C\xEDrculo de la pradera"
    use: "En el c\xEDrculo de piedras. El portal est\xE1 ah\xED: cruzalo para viajar."
    color: '#C93A7A'
    origin: StoneCircle
    x: 50
    z: -10
  - id: cave
    name: Portal de la cueva
    use: "En la c\xE1mara del fondo de la cueva. El portal est\xE1 ah\xED: cruzalo
