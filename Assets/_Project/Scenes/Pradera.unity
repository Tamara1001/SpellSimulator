    use: "Afuera de la torre, frente a su puerta. El portal est\xE1 ah\xED: cruzalo
      para viajar."
    color: '#8E4FD6'
    origin: StudyPortal
    x: 0
    z: 2
  - id: watchtower
    name: Portal de la atalaya
    use: "Arriba de la torre de vig\xEDa. El portal est\xE1 ah\xED: cruzalo para
      viajar."
    color: '#1F9E89'
    origin: Watchtower
    x: 37.28168
    z: 44.430576
  - id: field-circle
    name: "C\xEDrculo de la pradera"
    use: "En el c\xEDrculo de piedras. El portal est\xE1 ah\xED: cruzalo para viajar."
    color: '#C93A7A'
    origin: StoneCircle
    x: 50
    z: -10
  - id: cave
    name: Portal de la cueva
    use: "En la c\xE1mara del fondo de la cueva. El portal est\xE1 ah\xED: cruzalo
      para viajar."
    color: '#E2731E'
    origin: Cave
    x: -32.325077
    z: 51.73093
  - id: archive
    name: Portal del Archivo
    use: "Adentro del Archivo, al sur. El portal est\xE1 ah\xED: cruzalo para viajar."
    color: '#4F6FD6'
    origin: 
    x: 0
    z: -54
