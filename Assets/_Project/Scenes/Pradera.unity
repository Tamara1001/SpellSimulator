  m_Name: 
  m_EditorClassIdentifier: SpellSimulator.Runtime::SpellSimulator.World.Map.TowerMap
  zones:
  - id: tower
    name: Torre
    use: Biblioteca y estaciones de viento y agua; arriba, el estudio con portal
      y la alquimia.
    color: '#8E6B4A'
    origin: Tower
    x: 0
    z: 16
  - id: training
    name: Entrenamiento
    use: "Blancos, mu\xF1ecos y atril de papel para practicar sellos."
    color: '#D0563B'
    origin: Training
    x: -6
    z: -25
  - id: laboratory
    name: Laboratorio
    use: "Mesa de variables: cambi\xE1 el sello, lanzalo y registr\xE1 lo que pasa."
    color: '#4F7FC4'
    origin: Laboratory
    x: 20
    z: -8
  - id: cabin-north
    name: "Caba\xF1a del norte"
    use: Refugio con mesa y un libro de hechizos de viento y agua.
    color: '#B5793E'
    origin: Cabin_1
    x: -8
    z: 46
  - id: cabin-forest
    name: "Caba\xF1a del bosque"
    use: Refugio con mesa y un libro de hechizos de fuego y tierra.
    color: '#6E8F35'
    origin: Cabin_2
    x: -28
    z: 34
  - id: shrine
    name: Santuario
    use: "Cambi\xE1 runas gastadas o papeles por otros nuevos; el relicario guarda
      una runa de oro."
    color: '#D9A82E'
    origin: Shrine
    x: 34
    z: -36
  - id: stone-circle
    name: "C\xEDrculo de piedras"
    use: "Dibuj\xE1 el sello del portal en la placa para viajar."
    color: '#8A7FB8'
    origin: StoneCircle
    x: 50
    z: -10
  - id: supply-stall
    name: Puesto de suministros
    use: Papeles y runas de piedra que se reponen solos con el tiempo.
    color: '#C2853A'
    origin: SupplyStall
    x: 10
    z: 48
  - id: water-lab
    name: Laboratorio del lago
    use: "Ejercicios de agua: columna, dispersi\xF3n y empujar cajas al lago."
    color: '#3A9BB5'
    origin: WaterLab
    x: -44.1893
    z: 1.3383389
  - id: earth-workshop
    name: Taller de tierra
    use: Rocas, muros, puentes y romper paredes con el sigilo Tierra.
    color: '#9C6B3C'
    origin: EarthWorkshop
    x: 40
    z: 30
  - id: watchtower
    name: "Torre de vig\xEDa"
    use: "Sub\xED por la rampa: altura, portal y runas de piedra."
    color: '#5F8A55'
    origin: Watchtower
    x: 37.28168
    z: 44.430576
  - id: cave
    name: Cueva
    use: "Portal, tinta y runas de metal en la c\xE1mara del fondo."
    color: '#5E5A66'
    origin: Cave
    x: -32.325077
    z: 51.73093
  - id: lake
    name: Lago
    use: "Agua para tus hechizos; la cascada baja de las monta\xF1as del oeste."
    color: '#2F7FB0'
    origin: Lake
    x: -34
    z: -16
  - id: meadow
    name: Pradera
    use: Campo abierto y llano al este de la torre.
    color: '#8DB04A'
    origin: Field
    x: 28
    z: -6
  markers:
